# Local ApplyPilot worker. Copy to .env only when overriding defaults.
AGENT_PORT=8500
CV_API_BASE=http://127.0.0.1:8400

# Form-filling AI: use the signed-in Claude Code subscription on this Mac.
LLM_MODE=claude_subscription
LLM_MODEL=sonnet
CV_LENGTH=auto
CV_COMPILE_PDF=true
CV_USE_LLM=true
CV_ENHANCE_TAILOR=true
CV_COVERAGE_TARGET=0.95
CV_LLM_PROVIDER=anthropic
CV_LLM_MODEL=claude-sonnet-5

# Optional API fallback. The worker also reads ../.env without modifying it.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_API_KEY=

# The worker enforces this invariant even if the setting is changed.
STOP_BEFORE_SUBMIT=true
