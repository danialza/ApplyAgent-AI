# Local ApplyPilot worker. Copy to .env only when overriding defaults.
AGENT_PORT=8500
CV_API_BASE=http://127.0.0.1:8300

# Cheapest default: use the signed-in Claude Code subscription on this Mac.
LLM_MODE=claude_subscription
LLM_MODEL=sonnet
CV_LENGTH=auto

# Optional API fallback. The worker also reads ../.env without modifying it.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_API_KEY=

# The worker enforces this invariant even if the setting is changed.
STOP_BEFORE_SUBMIT=true
